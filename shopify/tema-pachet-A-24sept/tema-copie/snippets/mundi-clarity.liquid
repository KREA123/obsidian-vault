{%- comment -%}
  Microsoft Clarity prin script, fără aplicația din App Store (24.09 · pachet B, punctul 4).
  Aplicația cere acces „view and edit” la produse, comenzi și clienți; scriptul nu cere nimic.

  - Pornește doar dacă vizitatorul a acceptat cookie-urile de analiză
    (Shopify Customer Privacy API), inclusiv dacă acceptă mai târziu, din banner.
  - Se încarcă după „load”, în primul moment liber al browserului, ca să nu
    întârzie poza produsului (LCP) sau butonul de coș — la fel ca GA4 din temă.
  - Transmite și semnalul de consimțământ către Clarity (consentv2), cerut în SEE.
  - Checkout-ul nu se înregistrează (Clarity n-are acces acolo fără Shopify Plus).

  ID-ul proiectului îl dă Andu din clarity.microsoft.com → Settings → Overview.
  Cât timp clarity_id e gol, snippetul nu afișează nimic.
  Se randează în layout/theme.liquid, înainte de </head>: {% render 'mundi-clarity' %}
{%- endcomment -%}
{%- assign clarity_id = '' -%}
{%- if clarity_id != blank -%}
<script>
(function () {
  var ID = {{ clarity_id | json }}, pornit = false;
  function privacy() { return window.Shopify && window.Shopify.customerPrivacy; }
  function porneste() {
    var p = privacy();
    if (pornit || !p || !p.analyticsProcessingAllowed()) return;
    pornit = true;
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', ID);
    window.clarity('consentv2', {
      analytics_Storage: 'granted',
      ad_Storage: p.marketingAllowed() ? 'granted' : 'denied'
    });
  }
  function verifica() {
    if (privacy()) return porneste();
    /* API-ul de consimțământ nu e încă în pagină: îl cerem explicit (metoda documentată de Shopify pentru teme) */
    if (window.Shopify && window.Shopify.loadFeatures) {
      window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (err) { if (!err) porneste(); });
    }
  }
  function laMomentulLiber() {
    if ('requestIdleCallback' in window) requestIdleCallback(verifica, { timeout: 3000 });
    else setTimeout(verifica, 3000);
  }
  window.addEventListener('load', laMomentulLiber);
  document.addEventListener('visitorConsentCollected', porneste);
})();
</script>
{%- endif -%}
