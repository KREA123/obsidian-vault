  {%- comment -%}
    Săgeți pentru banda de categorii.

    Banda stă pe un rând și derulează lateral, dar derularea nu se
    vede — pe desktop, unde nu tragi cu degetul, categoriile din
    dreapta erau practic ascunse. Butoanele se construiesc din JS,
    nu din Liquid, ca să nu existe în pagină dacă scriptul nu rulează:
    fără el banda rămâne exact cum era, funcțională.

    Stă aici, nu în mundi.js, ca să nu adăugăm o a doua cerere — sunt
    sub 1 KB. Stilurile sunt în mundi-base.css, la .navsg.

    Nu produce sărituri de layout: stratul e position:absolute peste
    bandă, deci nu ocupă loc în flux.
  {%- endcomment -%}
  <script>
  (function () {
    var wrap = document.querySelector('.nav .wrap');
    var nav  = document.querySelector('.nav');
    if (!wrap || !nav) return;

    function sageata(cls, eticheta, cale) {
      return '<button type="button" class="' + cls + '" aria-label="' + eticheta + '">' +
             '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="' + cale + '"/></svg>' +
             '</button>';
    }
    var layer = document.createElement('div');
    layer.className = 'navsg';
    layer.innerHTML = sageata('sgp', 'Categoriile anterioare', 'M15 5 L8 12 L15 19') +
                      sageata('sgn', 'Categoriile următoare',  'M9 5 L16 12 L9 19');
    nav.appendChild(layer);

    /* Un pas = 70% din lățimea vizibilă. Nu 100%: lăsând o cărămidă
       din ecranul precedent, ochiul păstrează firul. */
    function pas() { return Math.round(wrap.clientWidth * 0.7); }

    function stare() {
      var max = wrap.scrollWidth - wrap.clientWidth;
      /* pragul de 2px acoperă rotunjirile la zoom sau la ecrane retina */
      layer.hidden = max <= 2;
      layer.setAttribute('data-start', wrap.scrollLeft <= 2 ? '1' : '0');
      layer.setAttribute('data-end', wrap.scrollLeft >= max - 2 ? '1' : '0');
    }

    layer.querySelector('.sgp').addEventListener('click', function () {
      wrap.scrollBy({ left: -pas(), behavior: 'smooth' });
    });
    layer.querySelector('.sgn').addEventListener('click', function () {
      wrap.scrollBy({ left: pas(), behavior: 'smooth' });
    });

    wrap.addEventListener('scroll', stare, { passive: true });
    window.addEventListener('resize', stare);
    stare();
  })();
  </script>
