PORT=3000
APP_URL=https://expedo.example.com
# Encrypts customer data (names, addresses, phones), courier/invoicing passwords and Shopify tokens.
# Never change it after go-live: the encrypted data could no longer be read.
APP_SECRET=
# Optional: password for using the dashboard outside the Shopify admin.
ADMIN_PASSWORD=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
DB_FILE=data/expedo.db
# Optional: company details shown on the privacy / terms pages, e.g. "CUI RO..., Str. ..., București".
PUBLISHER_DETAILS=
