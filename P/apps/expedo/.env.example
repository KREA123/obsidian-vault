PORT=3000
APP_URL=https://expedo.example.com
# Encrypts customer data (names, addresses, phones), courier/invoicing passwords and Shopify tokens.
# Never change it after go-live: the encrypted data could no longer be read.
APP_SECRET=
# Optional: password for using the dashboard outside the Shopify admin.
ADMIN_PASSWORD=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
DB_FILE=data/expedo.db
# Optional: company details shown on the privacy / terms pages, e.g. "CUI RO..., Str. ..., București".
PUBLISHER_DETAILS=
# Pricing (Shopify App Pricing, see PRICING.md). App handle from shopify.app.toml, used in the plan page URL.
SHOPIFY_APP_HANDLE=expedo
# Partner API client (Partner Dashboard → Settings → Partner API clients, permission "Manage apps"),
# your organization ID (in the Partner Dashboard URL) and the app's GID (gid://shopify/App/<id from the app's URL>).
# Needed to read the merchant's plan; without them the app falls back to the Admin API.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_APP_GID=
