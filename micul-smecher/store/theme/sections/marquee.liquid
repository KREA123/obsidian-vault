<div class="marq" aria-label="{{ 'soul.marq_label' | t }}" data-i18n-attr="aria-label:marq.label">
  <div class="marq-track">
    <ul>
      <li data-i18n="m1">{{ 'soul.m1' | t }}</li><li data-i18n="m2">{{ 'soul.m2' | t }}</li><li data-i18n="m3">{{ 'soul.m3' | t }}</li><li data-i18n="m4">{{ 'soul.m4' | t }}</li><li data-i18n="m5">{{ 'soul.m5' | t }}</li><li data-i18n="m6">{{ 'soul.m6' | t }}</li><li data-i18n="m7">{{ 'soul.m7' | t }}</li>
    </ul>
    <ul aria-hidden="true">
      <li data-i18n="m1">{{ 'soul.m1' | t }}</li><li data-i18n="m2">{{ 'soul.m2' | t }}</li><li data-i18n="m3">{{ 'soul.m3' | t }}</li><li data-i18n="m4">{{ 'soul.m4' | t }}</li><li data-i18n="m5">{{ 'soul.m5' | t }}</li><li data-i18n="m6">{{ 'soul.m6' | t }}</li><li data-i18n="m7">{{ 'soul.m7' | t }}</li>
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.marquee.name",
  "tag": "div",
