<section class="sec band" id="os" aria-labelledby="os-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow rv" data-i18n="os.eyebrow">{{ 'soul.os_eyebrow' | t }}</p>
      <h2 class="h-l rv" id="os-title" data-i18n="os.h2">{{ 'soul.os_h2_html' | t }}</h2>
      <p class="lead rv" data-i18n="os.lead">{{ 'soul.os_lead' | t }}</p>
    </div>
    <div class="os-alive">
      <figure class="os-dev rv">
        <div class="os-ring">
          <div class="os-glass" id="os-glass">
          <img class="on" src="{{ 'os-alive-dial-440.webp' | asset_url }}" srcset="{{ 'os-alive-dial-440.webp' | asset_url }} 440w, {{ 'os-alive-dial-880.webp' | asset_url }} 880w" sizes="(max-width:520px) calc(100vw - 60px), 440px" width="880" height="880" loading="lazy" decoding="async" data-shot="dial" alt="{{ 'soul.os_a1' | t }}" data-i18n-attr="alt:os.a1">
          <img src="{{ 'os-alive-eyes-440.webp' | asset_url }}" srcset="{{ 'os-alive-eyes-440.webp' | asset_url }} 440w, {{ 'os-alive-eyes-880.webp' | asset_url }} 880w" sizes="(max-width:520px) calc(100vw - 60px), 440px" width="880" height="880" loading="lazy" decoding="async" data-shot="eyes" alt="{{ 'soul.os_a2' | t }}" data-i18n-attr="alt:os.a2" aria-hidden="true">
          <img src="{{ 'os-alive-born-440.webp' | asset_url }}" srcset="{{ 'os-alive-born-440.webp' | asset_url }} 440w, {{ 'os-alive-born-880.webp' | asset_url }} 880w" sizes="(max-width:520px) calc(100vw - 60px), 440px" width="880" height="880" loading="lazy" decoding="async" data-shot="born" alt="{{ 'soul.os_a3' | t }}" data-i18n-attr="alt:os.a3" aria-hidden="true">
          <img src="{{ 'os-alive-blink-440.webp' | asset_url }}" srcset="{{ 'os-alive-blink-440.webp' | asset_url }} 440w, {{ 'os-alive-blink-880.webp' | asset_url }} 880w" sizes="(max-width:520px) calc(100vw - 60px), 440px" width="880" height="880" loading="lazy" decoding="async" data-shot="blink" alt="{{ 'soul.os_a4' | t }}" data-i18n-attr="alt:os.a4" aria-hidden="true">
            <span class="os-lid t" aria-hidden="true"></span><span class="os-lid b" aria-hidden="true"></span>
          </div>
        </div>
        <figcaption data-i18n="os.fig">{{ 'soul.os_fig' | t }}</figcaption>
      </figure>
      <div class="rv">
        <ol class="os-caps">
        <li><button type="button" class="os-cap" data-show="dial" aria-pressed="true" aria-controls="os-glass"><b data-i18n="os.c1t">{{ 'soul.os_c1t' | t }}</b><span data-i18n="os.c1">{{ 'soul.os_c1' | t }}</span></button></li>
        <li><button type="button" class="os-cap" data-show="eyes" aria-pressed="false" aria-controls="os-glass"><b data-i18n="os.c2t">{{ 'soul.os_c2t' | t }}</b><span data-i18n="os.c2">{{ 'soul.os_c2' | t }}</span></button></li>
        <li><button type="button" class="os-cap" data-show="born" aria-pressed="false" aria-controls="os-glass"><b data-i18n="os.c3t">{{ 'soul.os_c3t' | t }}</b><span data-i18n="os.c3">{{ 'soul.os_c3' | t }}</span></button></li>
        <li><button type="button" class="os-cap" data-show="blink" aria-pressed="false" aria-controls="os-glass"><b data-i18n="os.c4t">{{ 'soul.os_c4t' | t }}</b><span data-i18n="os.c4">{{ 'soul.os_c4' | t }}</span></button></li>
        </ol>
        <div class="os-sb">
          <p class="eyebrow" data-i18n="os.sbK">{{ 'soul.os_sbk' | t }}</p>
          <p data-i18n="os.sb">{{ 'soul.os_sb' | t }}</p>
        </div>
      </div>
    </div>
    {%- if section.settings.demo_url != blank -%}
    <div class="os-cta">
      <a class="btn" href="{{ section.settings.demo_url }}" target="_blank" rel="noopener"><span data-i18n="os.cta">{{ 'soul.os_cta' | t }}</span><span class="arr" aria-hidden="true">→</span></a>
      <p data-i18n="os.ctap">{{ 'soul.os_ctap' | t }}</p>
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.soulos.name",
  "tag": "div",
  "settings": [
    {
      "type": "url",
      "id": "demo_url",
      "label": "t:sections.soulos.demo_url",
      "info": "t:sections.soulos.demo_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.soulos.name"
    }
  ]
}
{% endschema %}
