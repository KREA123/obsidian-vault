<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="head">
      <p class="eyebrow" data-i18n="faq.eyebrow">{{ 'soul.faq_eyebrow' | t }}</p>
      <h2 class="h-l" id="faq-title" data-i18n="faq.h2">{{ 'soul.faq_h2' | t }}</h2>
    </div>
    <div class="faq" id="faq-list">
      <details id="faq-ce"><summary data-i18n="q1">{{ 'soul.q1' | t }}</summary><div class="a" data-i18n="a1">{{ 'soul.a1' | t }}</div></details>
      <details><summary data-i18n="q2">{{ 'soul.q2' | t }}</summary><div class="a" data-i18n="a2">{{ 'soul.a2' | t }}</div></details>
      <details><summary data-i18n="q3">{{ 'soul.q3' | t }}</summary><div class="a" data-i18n="a3">{{ 'soul.a3' | t }}</div></details>
      <details><summary data-i18n="q4">{{ 'soul.q4' | t }}</summary><div class="a" data-i18n="a4">{{ 'soul.a4' | t }}</div></details>
      <details><summary data-i18n="q5">{{ 'soul.q5' | t }}</summary><div class="a" data-i18n="a5">{{ 'soul.a5' | t }}</div></details>
      <details><summary data-i18n="q6">{{ 'soul.q6' | t }}</summary><div class="a" data-i18n="a6">{{ 'soul.a6' | t }}</div></details>
      <details><summary data-i18n="q7">{{ 'soul.q7' | t }}</summary><div class="a" data-i18n="a7">{{ 'soul.a7' | t }}</div></details>
      <details><summary data-i18n="q8">{{ 'soul.q8' | t }}</summary><div class="a" data-i18n="a8">{{ 'soul.a8' | t }}</div></details>
      <details><summary data-i18n="q9">{{ 'soul.q9' | t }}</summary><div class="a" data-i18n="a9">{{ 'soul.a9' | t }}</div></details>
      <details><summary data-i18n="q10">{{ 'soul.q10' | t }}</summary><div class="a" data-i18n="a10">{{ 'soul.a10' | t }}</div></details>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "div",
  "presets": [
    {
      "name": "t:sections.faq.name"
    }
  ]
}
{% endschema %}
