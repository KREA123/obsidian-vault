{%- liquid
  assign home = ''
  unless template.name == 'index'
    assign home = routes.root_url
  endunless
  assign res_href = home | append: '#reserve'
  if template.name == 'product'
    assign res_href = '#reserve'
  endif
-%}
<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href="{{ routes.root_url }}" aria-label="SOUL, back to top"><svg viewBox="2.96 61.82 489.04 144.35" aria-hidden="true" focusable="false"><path class="wm-ink" d="M59.4 202.8Q45.8 202.8 35.5 199.7Q25.2 196.6 18.2 190.7Q11.2 184.8 7.9 176.3Q4.6 167.8 5 157.2L32 151.4Q32 161.4 35.8 167.4Q39.6 173.4 46.2 176.2Q52.8 179 60.6 179Q67.6 179 72.9 177.2Q78.2 175.4 81.2 172.2Q84.2 169 84.2 164.6Q84.2 159 80.2 155.6Q76.2 152.2 69.5 149.9Q62.8 147.6 54.6 145.6Q46 143.2 37.5 140.4Q29 137.6 22 133.3Q15 129 10.7 122.1Q6.4 115.2 6.4 104.8Q6.4 92.4 12.8 83.6Q19.2 74.8 30.4 70Q41.6 65.2 56.4 65.2Q71.8 65.2 83.7 70.4Q95.6 75.6 102 85.5Q108.4 95.4 107.2 110L80.6 114.4Q81 108.2 79.4 103.4Q77.8 98.6 74.6 95.2Q71.4 91.8 66.6 90.1Q61.8 88.4 55.4 88.4Q48.6 88.4 43.9 90.2Q39.2 92 36.8 95.3Q34.4 98.6 34.4 103Q34.4 108 38 111.2Q41.6 114.4 48.1 116.6Q54.6 118.8 63 121Q71.6 123.2 80.2 126Q88.8 128.8 96.2 133.4Q103.6 138 108 145.2Q112.4 152.4 112.4 163.6Q112.4 176.4 105.6 185.2Q98.8 194 86.9 198.4Q75 202.8 59.4 202.8Z M326.6 202.8Q315.6 202.8 306.8 200.3Q298 197.8 291.5 193.1Q285 188.4 280.7 181.7Q276.4 175 274.3 166.6Q272.2 158.2 272.2 148.4V68H301V146.8Q301 157.2 304.1 163.9Q307.2 170.6 312.9 173.8Q318.6 177 326.6 177Q334.8 177 340.5 173.8Q346.2 170.6 349.2 163.9Q352.2 157.2 352.2 146.8V68H381.2V148.4Q381.2 174.4 367.2 188.6Q353.2 202.8 326.6 202.8Z M408.8 200V68H437.6V175.2H490V200Z"/><circle cx="190.2" cy="134" r="70.18" fill="#CBCDCF"/><circle cx="190.2" cy="134" r="64.21" fill="#0B0B0C"/><path fill="#FFF0C8" d="M180.82 125.78A12.84 21.83 0 1 1 160.14 121.91ZM220.26 121.91A12.84 21.83 0 1 1 199.58 125.78Z"/></svg></a>
    <nav class="nav-links" aria-label="Sections">
      <a href="{{ home }}#object" data-i18n="nav.object">{{ 'soul.nav_object' | t }}</a>
      <a href="{{ home }}#colours" data-i18n="nav.colours">{{ 'soul.nav_colours' | t }}</a>
      <a href="{{ home }}#born" data-i18n="nav.born">{{ 'soul.nav_born' | t }}</a>
      <a href="{{ home }}#ai" data-i18n="nav.ai">{{ 'soul.nav_ai' | t }}</a>
      <a href="{{ home }}#os" data-i18n="nav.os">{{ 'soul.nav_os' | t }}</a>
      <a href="{{ home }}#privacy" data-i18n="nav.privacy">{{ 'soul.nav_privacy' | t }}</a>
      <a href="{{ home }}#faq" data-i18n="nav.faq">{{ 'soul.nav_faq' | t }}</a>
    </nav>
    <div class="tools">
      <button class="snd" type="button" id="snd" aria-pressed="false" data-i18n-attr="aria-label:nav.sound" aria-label="{{ 'soul.nav_sound' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span data-i18n="nav.soundL">{{ 'soul.nav_soundl' | t }}</span></button>
      {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization', class: 'lang' -%}
        <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
        {%- for language in localization.available_languages -%}
          <button type="submit" name="language_code" value="{{ language.iso_code }}" data-lang="{{ language.iso_code }}" lang="{{ language.iso_code }}" aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}" aria-label="{{ language.endonym_name | escape }}">{{ language.iso_code | upcase }}</button>
        {%- endfor -%}
      {%- endform -%}
      {%- endif -%}
      {%- if settings.prelaunch -%}
      <a class="btn" href="{{ res_href }}"><span data-i18n="nav.cta">{{ 'soul.nav_cta' | t }}</span></a>
      {%- else -%}
      <a class="cartlink" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'soul.shop.cart' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Zm3 0a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a>
      {%- if settings.soul_product != blank -%}<a class="btn" href="{{ settings.soul_product.url }}"><span>{{ 'soul.shop.buy' | t }}</span></a>{%- endif -%}
      {%- endif -%}
    </div>
  </div>
</header>
{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "div",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "class": "section-header"
}
{% endschema %}
